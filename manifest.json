{
  "manifest_version": 3,
  "name": "PDF Viewer & Better Web Search",
  "version": "3.0.2",
  "description": "Leitor de PDF avançado e pesquisa web múltipla com Regex",
  "default_locale": "en",
  "permissions": ["storage", "tabs", "activeTab", "downloads", "unlimitedStorage"],
  "host_permissions": ["file:///*", "http://*/*", "https://*/*"],
  "action": {
    "default_title": "PDF Viewer & Better Web Search"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["search/js/content.js"],
      "css": ["search/css/content.css"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}